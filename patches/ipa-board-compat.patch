diff --git a/src/android/jni/mozcjni.cc b/src/android/jni/mozcjni.cc
index 5e9cb9b..d74f8f7 100644
--- a/src/android/jni/mozcjni.cc
+++ b/src/android/jni/mozcjni.cc
@@ -204,6 +204,28 @@ Java_com_google_android_apps_inputmethod_libs_mozc_session_MozcJni_initialize(
   return true;
 }
 
+// IPA Board's existing loader declares initialize() as void on MozcJNI.
+// Keep the upstream MozcJni boolean entry intact and register the native methods
+// against the actual calling class, so both Java entry points remain supported.
+JNIEXPORT void JNICALL
+Java_com_google_android_apps_inputmethod_libs_mozc_session_MozcJNI_initialize(
+    JNIEnv* env, jclass clazz) {
+  if (env == nullptr) {
+    return;
+  }
+  if (Java_com_google_android_apps_inputmethod_libs_mozc_session_MozcJni_initialize(
+          env, clazz) == JNI_TRUE ||
+      env->ExceptionCheck()) {
+    return;
+  }
+  // A void entry cannot report failure as a return value. Preserve any pending
+  // registration exception above; otherwise fail before onPostLoad is called.
+  jclass exception = env->FindClass("java/lang/IllegalStateException");
+  if (exception != nullptr) {
+    env->ThrowNew(exception, "Mozc JNI registration failed");
+  }
+}
+
 }  // extern "C"
 
 #endif  // __ANDROID__
